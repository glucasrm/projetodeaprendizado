generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  nome            String
  sobrenome       String
  email           String        @unique
  telefone        String
  passwordHash    String
  dataNascimento  DateTime?
  genero          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  profile         Profile?
  socialLinks     SocialLink[]  // <-- Relacionamento 1:N (Um usuário pode ter várias redes)
}

model Profile {
  userId   String @id @unique
  user     User   @relation(fields: [userId], references: [id])
  username String @unique
  avatar   String?
  banner   String?
  bio      String?
}

model SocialLink {
  id        String   @id @default(uuid())
  userId    String
  platform  String   // Exemplo: 'discord', 'instagram', 'youtube', 'facebook'
  url       String
  user      User     @relation(fields: [userId], references: [id])
}
