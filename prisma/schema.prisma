generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User {
  id          String   @id @default(uuid())
  nome        String
  sobrenome   String
  email       String   @unique
  telefone    String
  passwordHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile? // Adicione esta linha para a relação 1:1 com Profile
}

model Profile {
  userId   String @id @unique // userId é a chave primária e única
  user     User   @relation(fields: [userId], references: [id]) // Relação com o modelo User
  username String @unique
  avatar   String?
  banner   String?
  bio      String?
}
