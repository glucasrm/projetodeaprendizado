// schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String              @id @default(uuid())
  nome                    String
  sobrenome               String
  email                   String              @unique
  telefone                String
  passwordHash            String
  dataNascimento          DateTime?
  genero                  String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  profile                 Profile?
  socialLinks             SocialLink[]
  isAdmin                 Boolean             @default(false) // Adicionado para identificar mediadores
  balance                 Decimal             @default(0.00) @db.Decimal(10, 2) // Adicionado para saldo de apostas

  // Relacionamentos de amizade
  sentFriendRequests      Friend[]            @relation("UserFriends")
  receivedFriendRequests  Friend[]            @relation("FriendOf")

  teams                   TeamMember[]
  tournamentsCreated      Tournament[]
  notifications           Notification[]

  // Novos relacionamentos para o sistema de apostas de confronto direto
  directBets              DirectBet[]         @relation("PlayerDirectBets")
  matchesAsPlayer1        Match[]             @relation("Player1")
  matchesAsPlayer2        Match[]             @relation("Player2")
  matchesAsMediator       Match[]             @relation("Mediator")
  mediationRequests       MediationRequest[]
  conversations           Conversation[]      @relation("Participants")
  messages                Message[]           // Mensagens enviadas em conversas

  // Seu modelo Bet existente para torneios
  tournamentBets          TournamentBet[]     @relation("TournamentBetsUser")

  // novo relaciomento com estatísticas
  playerStatistics      PlayerStatistics[]

  @@map("users")
}

model Profile {
  userId   String @id @unique
  user     User   @relation(fields: [userId], references: [id])
  username String @unique
  avatar   String?
  banner   String?
  bio      String?

  @@map("profiles")
}

model SocialLink {
  id       String @id @default(uuid())
  userId   String
  platform String
  url      String
  user     User   @relation(fields: [userId], references: [id])

  @@map("social_links")
}

model Friend {
  id             String   @id @default(uuid())
  requester      User     @relation("UserFriends", fields: [requesterId], references: [id])
  requesterId    String
  receiver       User     @relation("FriendOf", fields: [receiverId], references: [id])
  receiverId     String
  status         String   // "pending", "accepted", "declined"
  createdAt      DateTime @default(now())

  @@unique([requesterId, receiverId])
  @@map("friends")
}

model Tournament {
  id                String          @id @default(uuid())
  name              String
  game              String
  createdBy         User            @relation(fields: [createdById], references: [id])
  createdById       String
  participants      Team[]
  startDate         DateTime
  tournamentBets    TournamentBet[] // Relacionamento reverso

  @@map("tournaments")
}

model Team {
  id           String       @id @default(uuid())
  name         String
  members      TeamMember[]
  tournament   Tournament?  @relation(fields: [tournamentId], references: [id])
  tournamentId String?

  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  @@map("team_members")
}

// Seu modelo Bet existente, renomeado para TournamentBet para clareza
model TournamentBet {
  id           String     @id @default(uuid())
  user         User       @relation("TournamentBetsUser", fields: [userId], references: [id])
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String
  amount       Decimal    @db.Decimal(10, 2) // Usando Decimal para precisão
  createdAt    DateTime   @default(now())

  @@map("tournament_bets")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  content   String
  link      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  message   String // Mantido, mas 'content' parece ter a mesma função
  // Adicionar coluna `matchId` para vincular notificações a confrontos
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id])

  @@map("notifications")
}

// --- Novos modelos para o sistema de apostas de confronto direto ---

model DirectBet {
  id              String       @id @default(uuid())
  playerId        String
  player          User         @relation("PlayerDirectBets", fields: [playerId], references: [id])
  betAmount       Decimal      @db.Decimal(10, 2)
  modality        String       // '1v1', '2v2', '3v3', '4v4'
  platform        String       // 'Mobile', 'Emulador'
   gameSlug        String?      // Adicionado para registrar o jogo da aposta
  status          String       @default("WAITING_OPPONENT") // WAITING_OPPONENT, MATCHED, IN_PROGRESS, COMPLETED, CANCELED
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  matchId         String?
  match           Match?       @relation(fields: [matchId], references: [id])

  @@map("direct_bets") // Renomeado para evitar conflito com 'bets' existente
}

model Match {
 id                String             @id @default(uuid())
  player1Id         String
  player1           User               @relation("Player1", fields: [player1Id], references: [id])
  player2Id         String
  player2           User               @relation("Player2", fields: [player2Id], references: [id])
  mediatorId        String?
  mediator          User?              @relation("Mediator", fields: [mediatorId], references: [id])
  betAmount         Decimal            @db.Decimal(10, 2)
  modality          String
  platform          String
  gameSlug          String?            // Adicionado para registrar o jogo da partida. Torne opcional (?) se nem todas as partidas tiverem um jogo.
  status            String   // Valores possíveis: PENDING_CONFIRMATION, IN_PROGRESS, COMPLETED, CANCELLED
  chatRoomId        String?            @unique // ID para o chat
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  result            String?            // Ex: "player1_won", "player2_won", "draw"

  directBets        DirectBet[]
  conversation      Conversation?
  notifications     Notification[]

    // NOVOS CAMPOS PARA CONFIRMAÇÃO
  player1Confirmed  Boolean  @default(false)
  player2Confirmed  Boolean  @default(false)
  mediatorConfirmed Boolean  @default(false)

  // novo relaciomento com estatísticas
  // statistics            MatchStatistics?

  @@map("matches")
}

model MediationRequest {
  id          String   @id @default(uuid())
  mediatorId  String   @unique
  mediator    User     @relation(fields: [mediatorId], references: [id])
  modalities  String[] // ex: ["1v1", "2v2"]
  platforms   String[] // ex: ["Mobile", "Emulador"]
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mediation_requests")
}

model Conversation {
  id            String       @id @default(uuid())
  matchId       String       @unique
  match         Match        @relation(fields: [matchId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  participants  User[]       @relation("Participants")
  messages      Message[]

  @@map("conversations")
}

model Message {
  id            String       @id @default(uuid())
  conversationId String
  conversation  Conversation @relation(fields: [conversationId], references: [id])
  senderId      String
  sender        User         @relation(fields: [senderId], references: [id])
  content       String
  createdAt     DateTime     @default(now())

  @@map("messages")
}
// Modelo de dados para estatísticas de jogadores
// Adicione este modelo ao seu schema.prisma existente

model PlayerStatistics {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  gameSlug              String   // Para separar estatísticas por jogo
  
  // ESTATÍSTICAS OBRIGATÓRIAS (sempre preenchidas)
  totalMatches          Int      @default(0)  // Total de partidas jogadas
  wins                  Int      @default(0)  // Vitórias normais
  losses                Int      @default(0)  // Derrotas normais
  winsWO                Int      @default(0)  // Vitórias por W.O
  lossesWO              Int      @default(0)  // Derrotas por W.O
  
  // ESTATÍSTICAS OPCIONAIS (nem sempre preenchidas)
  kills                 Int      @default(0)  // Total de kills
  assists               Int      @default(0)  // Total de assistências
  caps                  Int      @default(0)  // Total de capas
  
  // CONTADORES DE PRECISÃO (para calcular médias corretas)
  matchesWithKills      Int      @default(0)  // Quantas partidas tiveram kills informados
  matchesWithAssists    Int      @default(0)  // Quantas partidas tiveram assists informados
  matchesWithCaps       Int      @default(0)  // Quantas partidas tiveram capas informados
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Índice único para evitar duplicatas por usuário/jogo
  @@unique([userId, gameSlug])
  @@map("player_statistics")
}

// Modelo para armazenar estatísticas detalhadas de cada partida
model MatchStatistics {
  id                    String   @id @default(uuid())
  matchId               String   @unique
  match                 Match    @relation(fields: [matchId], references: [id])
  
  // RESULTADO DA PARTIDA (obrigatório)
  result                String   // "player1_win", "player2_win", "draw", "player1_wo", "player2_wo", "cancelled"
  
  // ESTATÍSTICAS DO JOGADOR 1 (opcionais)
  player1Kills          Int?     // Kills do jogador 1 (null se não informado)
  player1Assists       Int?     // Assists do jogador 1 (null se não informado)
  player1Caps          Int?     // Capas do jogador 1 (null se não informado)
  
  // ESTATÍSTICAS DO JOGADOR 2 (opcionais)
  player2Kills          Int?     // Kills do jogador 2 (null se não informado)
  player2Assists       Int?     // Assists do jogador 2 (null se não informado)
  player2Caps          Int?     // Capas do jogador 2 (null se não informado)
  
  // METADADOS
  completedBy           String   // ID do mediador que finalizou
  completedAt           DateTime @default(now())
  
  @@map("match_statistics")
}
